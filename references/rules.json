  "version": "1.1.0",
  "rules": [
    {
      "id": "retrieval-metrics",
      "name": "信息检索教材：查全率与查准率",
      "status": "verified",
      "freshness": "stable",
      "url": "https://nlp.stanford.edu/IR-book/html/htmledition/evaluation-of-unranked-retrieval-sets-1.html",
      "verified_at": "2026-10-09T12:10:40.059Z",
      "scope": "已给定相关总量、检出量及相关检出量时的指标与比例公式；不证明实际数据库数量",
      "claims": {
        "recall": "查全率（召回率）= 相关检出量 / 全部相关量",
        "precision": "查准率（精确率）= 相关检出量 / 全部检出量",
        "ratio": "部分占总体的比例 = 部分 / 总体；百分数 = 比例 × 100%"
      },
      "exclusions": [
        "数据库实时数量或排名",
        "题干未给定的数据",
        "无法明确对应的分子分母"
      ],
      "artifacts": [
        {
          "path": "references/rule-evidence/retrieval-metrics.json",
          "sha256": "29780293a81122f7624349c35d5c8121723cc8019b425c03fec525980bfe0ca2"

    {
      "id": "boolean-operators",
      "name": "信息检索教材：通用布尔语义",
      "status": "verified",
      "freshness": "stable",
      "url": "https://nlp.stanford.edu/IR-book/html/htmledition/an-example-information-retrieval-problem-1.html",
      "verified_at": "2026-10-09T12:12:17.809Z",
      "scope": "通用布尔检索模型的集合与逻辑语义；不包含某数据库的实际语法、优先级和默认匹配方式",
      "claims": {
        "and": "AND 表示同时满足两条件，集合取交集；在相同总体与匹配口径下不能扩大结果集合",
        "or": "OR 表示至少满足一个条件，集合取并集（包括同时满足）；在相同总体与匹配口径下不能缩小结果集合",
        "not": "NOT 表示否定或排除条件；A AND NOT B 为属于 A 且不属于 B 的集合"
      },
      "exclusions": [
        "厂商特定字段、引号、运算符优先级与匹配规则",
        "动态数量、排名和版本功能",
        "新增术语后相关性与查准率必然变化的断言"
      ],
      "artifacts": [
